{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/delete-account", "destination": "/account-deletion/", "permanent": true },
    { "source": "/privacy", "destination": "/privacy-policy/", "permanent": true },
    { "source": "/child-safety-standards", "destination": "/child-safety/", "permanent": true },
    { "source": "/trust", "destination": "/safety-center/", "permanent": true },
    { "source": "/data-safety", "destination": "/data-practices/", "permanent": true }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "X-Frame-Options", "value": "DENY" }
    ] }
  ]
}
